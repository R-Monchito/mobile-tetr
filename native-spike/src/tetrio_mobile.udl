namespace tetrio_mobile_core {
};

enum CommandKind {
  "MoveLeft",
  "MoveRight",
  "SoftDrop",
  "HardDrop",
  "RotateCw",
  "RotateCcw",
  "Rotate180",
  "Hold",
  "Tick",
};

dictionary EngineCommand {
  CommandKind kind;
  u32 delta_ms;
};

enum PieceType { "I", "J", "L", "O", "S", "T", "Z" };

dictionary BoardState {
  u16 width;
  u16 height;
  sequence<u8> cells;
};

dictionary PieceState {
  PieceType piece_type;
  i32 x;
  i32 y;
  u8 rotation;
};

dictionary RandomizerState {
  sequence<PieceType> bag;
  u32 index;
  u32 seed;
};

enum LastAction { "Spawn", "Move", "Rotate", "Drop", "Hold", "Lock" };

dictionary LockDelayState {
  u32 elapsed_ms;
  u32 resets;
  boolean locked;
};

dictionary SnapshotContract {
  BoardState board;
  u64 score;
  u32 lines;
  boolean game_over;
  PieceState? current_piece;
  sequence<PieceType> next_pieces;
  PieceType? held_piece;
  boolean can_hold;
  RandomizerState randomizer;
  LastAction last_action;
  string? last_rotation_transition;
  u8? kick_index;
  LockDelayState lock_delay;
  i32 combo;
  boolean back_to_back;
  string ruleset_version;
  u32 soft_drop_cells;
};

dictionary EngineCapabilities {
  boolean replay;
  boolean deterministic_rng;
  boolean network;
};

enum EngineEventKind {
  "Spawned",
  "Moved",
  "Rotated",
  "SoftDropped",
  "HardDropped",
  "Locked",
  "LinesCleared",
  "Held",
  "GameOver",
};

dictionary EngineEvent {
  EngineEventKind kind;
  u32 value;
  PieceType? piece;
};

enum EngineError { "InvalidBoard", "GameOver", "InvalidCommand" };

dictionary EngineResult {
  SnapshotContract snapshot;
  sequence<EngineEvent> events;
  EngineError? error;
};

interface EngineSession {
  constructor(SnapshotContract initial);
  EngineCapabilities capabilities();
  SnapshotContract snapshot();
  EngineResult apply_command(EngineCommand command);
};